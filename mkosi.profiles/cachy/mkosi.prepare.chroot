#!/usr/bin/env bash
# Registers the CachyOS repo/keyring, same as build_files/cachy.sh. Needs
# network (key server + CachyOS mirror), hence prepare.chroot rather than
# postinst.chroot. See the caveat in mkosi.profiles/cachy/mkosi.conf --
# this path is unverified.
set -xeuo pipefail

pacman-key --recv-keys F3B607488DB35A47 --keyserver keyserver.ubuntu.com
pacman-key --lsign-key F3B607488DB35A47

mirror_url="https://mirror.cachyos.org/repo/x86_64/cachyos"
tmpconf="$(mktemp)"
cp /etc/pacman.conf "$tmpconf"
sed -i 's/SigLevel *=.*/SigLevel = Never/' "$tmpconf"
pacman -U --noconfirm --config "$tmpconf" \
	"${mirror_url}/cachyos-keyring-20240331-1-any.pkg.tar.zst" \
	"${mirror_url}/cachyos-mirrorlist-27-1-any.pkg.tar.zst" \
	"${mirror_url}/cachyos-v3-mirrorlist-27-1-any.pkg.tar.zst"
rm -f "$tmpconf"

if ! grep -q "^\[cachyos\]" /etc/pacman.conf; then
	cat <<-'EOF' >>/etc/pacman.conf

	[cachyos]
	Include = /etc/pacman.d/cachyos-mirrorlist
	EOF
fi

#!/usr/bin/env bash
# Installs the bootc binaries built by mkosi.prepare.chroot into the image,
# then sanity-checks and lints. Runs with no network (postinst.chroot),
# which is fine -- the actual build already happened in mkosi.prepare.chroot
# with everything staged under $SRCDIR/cache; this just copies it in.
set -xeuo pipefail

cp -a "${SRCDIR}/cache/bootc-output"/. /

stat /usr/bin/bootc

# Non-fatal by default, matching tunaOS's finalize.sh (HOME=/tmp because
# /root is a bind-mount target that doesn't exist yet at build time -- see
# mkosi.finalize.chroot). Set BOOTC_LINT_FATAL=1 in the build environment to
# make lint failures fail the build instead of just warning.
if ! HOME=/tmp bootc container lint; then
    if [[ "${BOOTC_LINT_FATAL:-0}" == "1" ]]; then
        exit 1
    fi
    echo "WARNING: bootc container lint reported findings (non-fatal, set BOOTC_LINT_FATAL=1 to enforce)"
fi
